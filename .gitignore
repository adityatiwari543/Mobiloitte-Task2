# Dependencies
node_modules/
/.pnp
.pnp.js

# Environment variables & sensitive credentials (NEVER commit secrets to GitHub)
.env
.env.*
*.env
backend/.env
frontend/.env
!.env.example
!*.env.example

# Private keys, certificates, and local credentials
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
id_rsa*
*.pub

# Build and distribution outputs
dist/
build/
backend/dist/
frontend/dist/
shared/dist/

# Test coverage
coverage/
*.lcov

# User uploaded files (resumes, avatars, documents)
uploads/*
!uploads/.gitkeep
backend/uploads/*
!backend/uploads/.gitkeep

# Database dumps & local storage
*.dump
*.sql
*.sqlite
*.db

# System and editor directories
.vscode/
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
Thumbs.db

# Logs and runtime artifacts
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Temporary files
tmp/
temp/
.turbo
