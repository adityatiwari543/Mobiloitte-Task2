# Environment
NODE_ENV=development
PORT=5000

# Client Configuration
FRONTEND_URL=http://localhost:5173
COOKIE_DOMAIN=localhost

# Database & Cache
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/JobConnect?retryWrites=true&w=majority
REDIS_URL=redis://localhost:6379

# JWT Secrets (Generate secure 256-bit random keys in production)
JWT_ACCESS_SECRET=your_jwt_access_secret_32chars_min!
JWT_REFRESH_SECRET=your_jwt_refresh_secret_32chars_min!
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CSRF Secret
CSRF_SECRET=your_csrf_secret_random_key_value_here!

# AI Configuration (gemini | openai | deterministic)
AI_PROVIDER=deterministic
AI_API_KEY=your_gemini_or_openai_api_key_here
AI_MODEL_NAME=gemini-1.5-flash

# Email / SMTP Settings (Gmail / SendGrid / Mailtrap)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_digit_app_password
FROM_EMAIL=your_email@gmail.com

# File Upload Storage (local | s3 | cloudinary)
STORAGE_PROVIDER=local
STORAGE_DIR=./uploads
